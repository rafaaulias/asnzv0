{
  "expo": {
    "name": "Anti-Snooze",
    "slug": "anti-snooze",
    "scheme": "anti-snooze",
    "version": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/6cfdd03f-96d0-46aa-8abc-767cb46bb1be",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": { "expo-channel-name": "preview" }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/radar.mp3",
            "./assets/sounds/bell.mp3",
            "./assets/sounds/beep.mp3",
            "./assets/sounds/keyboard.mp3",
            "./assets/sounds/click.mp3",
            "./assets/sounds/toggle.mp3"
          ]
        }
      ],
      "expo-router",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "./plugins/with-alarm-activity.js"
    ],
    "android": {
      "package": "com.antisnooze.alarm",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.antisnooze.alarm",
      "infoPlist": {
        "NSMotionUsageDescription": "Anti-Snooze uses motion to verify shake challenges.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ]
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cfdd03f-96d0-46aa-8abc-767cb46bb1be"
      }
    },
    "runtimeVersion": "1.0.0"
  }
}
